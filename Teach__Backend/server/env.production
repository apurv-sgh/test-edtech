# ===========================================
# PRODUCTION Environment Variables for Render Deployment
# ===========================================

# Application Environment
NODE_ENV=production
PORT=4000

# JWT Configuration - Strong secret for production
JWT_SECRET=zegnite_teacher_backend_jwt_secret_2024_secure_key_production
JWT_EXPIRATION=30d

# Database Configuration
MONGODB_URI=mongodb+srv://zegnitetestserver_db_user:ImDkOpPZVIjcVaXr@teacherdatabase.nujbpdo.mongodb.net/teacherdatabase?retryWrites=true&w=majority

# Session Configuration
SESSION_SECRET=zegnite_teacher_session_secret_2024_production

# File Upload Configuration
MAX_VIDEO_SIZE=524288000
MAX_NOTES_SIZE=10485760

# Frontend URL (for CORS configuration)
FRONTEND_URL=https://zegnite-frontend.onrender.com

# CORS Origins - All Render deployment URLs
# Main frontend and backends
CORS_ORIGINS=https://zegnite-frontend.onrender.com,https://zegnite-backend2.onrender.com,https://zegnite-teach-back-oini.onrender.com

# Render-specific Configuration
RENDER_EXTERNAL_URL=https://zegnite-teach-back-oini.onrender.com
RENDER_FRONTEND_URL=https://zegnite-frontend.onrender.com
RENDER_MAIN_BACKEND_URL=https://zegnite-backend2.onrender.com

# Security Settings
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Third-party Service Keys (if needed)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
